<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>iPhone Cam</string>
    <key>CFBundleIdentifier</key>
    <string>com.local.iphonecam</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>

    <!-- Camera permission -->
    <key>NSCameraUsageDescription</key>
    <string>Streams your camera to your PC as a high-quality webcam.</string>

    <!-- Local network permission (for TCP server) -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Accepts connections from your PC to stream the camera feed.</string>

    <!-- Keep running in background via VoIP socket -->
    <key>UIBackgroundModes</key>
    <array>
        <string>voip</string>
    </array>

    <!-- Supported orientations -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>

    <key>UIRequiredDeviceCapabilities</key>
    <array>
        <string>camera</string>
    </array>

    <key>UILaunchScreen</key>
    <dict/>
</dict>
</plist>
